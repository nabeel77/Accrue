# The web app. These are what it deploys with. No key of any kind, and no path on anybody's
# machine: the web app holds nothing it could sign with.

SOLANA_CLUSTER=mainnet
HELIUS_RPC_URL=
HELIUS_MAX_REQUESTS_PER_SECOND=20

DATABASE_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

SESSION_SECRET=
SESSION_TTL_DAYS=7
AUTH_NONCE_TTL_MINUTES=5
AUTH_DOMAIN=accrue.app

CRON_SECRET=

# The sandbox faucet the app asks on behalf of a signed in wallet. Devnet only.
DEVNET_FAUCET_URL=http://127.0.0.1:8787/grant
DEVNET_FAUCET_SECRET=

# The sandbox price service, behind the same secret. Devnet only, and the one thing the app can
# ask it for is a move in one price or a reset of every price to the book.
DEVNET_PRICES_URL=http://127.0.0.1:8788

ACCRUE_PROGRAM_ID=
ACCRUE_BUILD_HASH=
ACCRUE_UPGRADE_AUTHORITY=

JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
DEFILLAMA_YIELDS_URL=https://yields.llama.fi/pools

# Caps. These defaults are the ceiling, never raise them in code.
MAX_LTV_SHARE_OF_LIMIT=0.75
MAX_SHARE_OF_AVAILABLE_LIQUIDITY=0.10
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_PCT=1
MIN_POSITION_USD=10
MAX_POSITION_USD=50000
PRIORITY_FEE_LAMPORTS=50000

POSITION_BUILDING_ENABLED=true

RATE_LIMIT_NONCE_PER_IP=10
RATE_LIMIT_VERIFY_PER_IP=10
RATE_LIMIT_BUILD_PER_WALLET=6
RATE_LIMIT_SUBMIT_PER_WALLET=6
RATE_LIMIT_READ_PER_WALLET=60
RATE_LIMIT_FAUCET_PER_WALLET=2

NEXT_PUBLIC_APP_URL=https://accrue.app
NEXT_PUBLIC_EXPLORER_URL=https://solscan.io
