# Scripts run from a laptop, and nothing else. Nothing here is deployed: the web app reads
# apps/web/.env.example and the keeper reads apps/keeper/.env.example. This is the only one of the
# three that names a key or a folder, because this is the only one that runs on a person's machine.

SOLANA_CLUSTER=devnet
HELIUS_RPC_URL=

# The admin key. It is also the mint authority of every sandbox mint, so the faucet mints with it.
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
DEVNET_KEYPAIR_DIR=~/.config/accrue/devnet

DEVNET_FAUCET_PORT=8787
DEVNET_FAUCET_SECRET=

# The price service walks the sandbox market. It writes every price on the first interval so
# nothing goes stale, and moves the stocks on the second. The secret is the faucet's.
DEVNET_PRICES_PORT=8788
DEVNET_PRICE_WRITE_SECONDS=20
DEVNET_PRICE_STEP_SECONDS=300
# The largest ordinary move a step makes, up or down, and how much of the gap back to the book
# price a step closes.
DEVNET_PRICE_STEP_PERCENT=4
DEVNET_PRICE_PULL_PERCENT=25
# The chance a step is a big fall instead, about one step in twelve, so about one an hour, and
# how far it falls before climbing back over the steps that follow.
DEVNET_PRICE_BIG_MOVE_ODDS=0.083
DEVNET_PRICE_BIG_MOVE_LOW_PERCENT=20
DEVNET_PRICE_BIG_MOVE_HIGH_PERCENT=25
DEVNET_PRICE_RECOVERY_STEPS=6

# The yield token earns rather than moves, so on a sandbox it earns this many times faster than
# the clock, which is the only way a rate published per year shows up in a sitting. One is real time.
DEVNET_YIELD_TIMES_FASTER=20000

# A wallet used for the end to end run and nothing else, and a folder outside the repo to write to.
E2E_WALLET_KEYPAIR_PATH=~/.config/accrue/devnet/e2e-wallet-keypair.json
E2E_SCREENSHOT_DIR=~/.config/accrue/devnet/screenshots

# Migrations run from here.
DATABASE_DIRECT_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# What the config initialisation script writes into the program config.
ACCRUE_CONFIG_MIN_POSITION_USD=10
ACCRUE_CONFIG_MAX_POSITION_USD=50
ACCRUE_CONFIG_MAX_SLIPPAGE_BPS=100
ACCRUE_CONFIG_MAX_PRICE_AGE_SLOTS=150
ACCRUE_CONFIG_KEEPER_BOUNTY_BPS=10
ACCRUE_CONFIG_KEEPER_BOUNTY_CAP_USDC=5
ACCRUE_CONFIG_PERFORMANCE_FEE_BPS=1000
ACCRUE_CONFIG_MIN_PROTECT_INTERVAL_SECONDS=60
ACCRUE_CONFIG_MIN_GROW_INTERVAL_SECONDS=3600
ACCRUE_CONFIG_MAX_SHARE_OF_AVAILABLE_BPS=1000
ACCRUE_TREASURY_USDC_ACCOUNT=
ACCRUE_GUARDIAN=
ACCRUE_BORROW_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
ACCRUE_BORROW_RESERVE=97zoywd8mPZsGTg8q1wdD2Wgkdrs2tqusp1Qqcxbyj7E

# Read by the destination check and the fixture scripts.
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Reference only, for the scripts that snapshot mainnet accounts.
KAMINO_XSTOCKS_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua
KAMINO_XSTOCKS_LOOKUP_TABLE=8ofreL6hKfEet1DnhHVGvCTnSdz4pg85PpbuCUHnEcKm
KAMINO_API_URL=https://api.kamino.finance
