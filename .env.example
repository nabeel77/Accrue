# Every variable the code reads. Copy to .env and fill in. Nothing here is ever committed
# with a value, and no key is ever a value in this file, only a path to a file outside it.

# Database (Supabase Postgres). Pooled string for the app, direct string for migrations. Server only.
DATABASE_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Solana RPC. Server only. All chain reads and sends go through this.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
HELIUS_MAX_REQUESTS_PER_SECOND=20

# The Accrue program. Public. The config address is derived from it.
ACCRUE_PROGRAM_ID=
# Limits written into the program config at initialisation, changed later with one
# update_config transaction signed by ADMIN_KEYPAIR_PATH. Never changed in code.
ACCRUE_CONFIG_MIN_POSITION_USD=10
ACCRUE_CONFIG_MAX_POSITION_USD=50
ACCRUE_CONFIG_MAX_SLIPPAGE_BPS=100
ACCRUE_CONFIG_MAX_PRICE_AGE_SLOTS=150
ACCRUE_CONFIG_KEEPER_BOUNTY_BPS=10
ACCRUE_CONFIG_KEEPER_BOUNTY_CAP_USDC=5
ACCRUE_CONFIG_PERFORMANCE_FEE_BPS=1000
ACCRUE_CONFIG_MIN_PROTECT_INTERVAL_SECONDS=600
ACCRUE_CONFIG_MIN_GROW_INTERVAL_SECONDS=3600
ACCRUE_CONFIG_MAX_SHARE_OF_AVAILABLE_BPS=1000
# The token account fees are sent to, and the key that may pause opens and grows.
ACCRUE_TREASURY_USDC_ACCOUNT=
ACCRUE_GUARDIAN=
# The one side every position borrows: the mint and the reserve it comes from. Written into the
# config at initialisation and copied onto each position when it opens.
ACCRUE_BORROW_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
ACCRUE_BORROW_RESERVE=97zoywd8mPZsGTg8q1wdD2Wgkdrs2tqusp1Qqcxbyj7E

# Admin scripts only, scripts/config. The key is a file path, never a value in this file,
# never read by the web app or the keeper.
ADMIN_KEYPAIR_PATH=

# Keeper, apps/keeper only. The key is a file path, never a value in this file.
KEEPER_RPC_URL=
KEEPER_KEYPAIR_PATH=
KEEPER_INTERVAL_SECONDS=30
KEEPER_PRIORITY_FEE_LAMPORTS=50000

# Kamino
KAMINO_XSTOCKS_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua
KAMINO_XSTOCKS_LOOKUP_TABLE=8ofreL6hKfEet1DnhHVGvCTnSdz4pg85PpbuCUHnEcKm
KAMINO_API_URL=https://api.kamino.finance

# Jupiter. The key is optional, without it the lite host is used.
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Yield data
DEFILLAMA_YIELDS_URL=https://yields.llama.fi/pools

# Caps. These defaults are the ceiling, never raise them in code.
MAX_LTV_SHARE_OF_LIMIT=0.75
MAX_SHARE_OF_AVAILABLE_LIQUIDITY=0.10
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_PCT=1
MIN_POSITION_USD=10
MAX_POSITION_USD=50000

# Priority fee for every transaction we build, total lamports. Version 1 takes it in the
# header, version 0 gets it converted to micro lamports per compute unit.
PRIORITY_FEE_LAMPORTS=50000

# Kill switch. false disables build, submit and unwind routes at once.
POSITION_BUILDING_ENABLED=true

# Auth and sessions. Server only. Generate SESSION_SECRET with openssl rand -base64 32.
SESSION_SECRET=
SESSION_TTL_DAYS=7
AUTH_NONCE_TTL_MINUTES=5
AUTH_DOMAIN=accrue.app

# Cron routes on Vercel. Generate with openssl rand -base64 32.
CRON_SECRET=

# Rate limits, requests per minute
RATE_LIMIT_NONCE_PER_IP=10
RATE_LIMIT_VERIFY_PER_IP=10
RATE_LIMIT_BUILD_PER_WALLET=6
RATE_LIMIT_SUBMIT_PER_WALLET=6
RATE_LIMIT_READ_PER_WALLET=60

# Web
NEXT_PUBLIC_APP_URL=https://accrue.app
NEXT_PUBLIC_EXPLORER_URL=https://solscan.io
